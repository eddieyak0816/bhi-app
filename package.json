{
  "name": "bhi-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "deploy": "npm run build && git add dist -f && git commit -m 'Deploy to GitHub Pages' && git subtree push --prefix dist origin gh-pages",
    "seed:db": "psql $DATABASE_URL -f ./db/seed.sql",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "dev:server": "node server/index.js",
    "start:server": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.32.0",
    "body-parser": "^2.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.1.4",
    "express": "^4.18.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.40.0",
    "@types/react": "18.0.28",
    "@types/react-dom": "18.0.11",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "10.4.14",
    "postcss": "8.4.24",
    "tailwindcss": "3.4.7",
    "typescript": "5.4.2",
    "vite": "5.1.0"
  }
}
